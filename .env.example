# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg://querylens_user:querylens_secure_pass@localhost:5432/querylens_app

# JWT & Credential Encryption
SECRET_KEY=querylens-super-secret-key-change-in-production-32bytes!
ENCRYPTION_KEY=uK23k_Oq96ZcZ_bHnI8K_bN_6uV3mR7p8G1s_0oJk9Y=

# Security & Network
ALLOW_PRIVATE_IPS=true
QUERY_TIMEOUT_SECONDS=30
DEFAULT_ROW_LIMIT=500

# LLM Provider Configuration
